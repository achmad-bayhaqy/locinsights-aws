generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x", "linux-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ABTest {
  @@map("ab_tests")
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name       String
  scenario_a Json
  scenario_b Json
  metrics    Json?    @default("{}")
  winner     String?
  created_by String?  @default("system")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  tenant_id           String?
  tenant              Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Brand {
  @@map("brands")
  id                  String                    @id
  name                String
  parent              brand_parent_enum         @default(MAA)
  category            brand_category_enum
  origin_country      String?                   @default("Indonesia")
  format              String?
  location_preference location_format_enum?     @default(both)
  typical_size_m2     Int?                      @default(0)
  target_audience     String?                   @default("")
  price_segment       brand_price_segment_enum? @default(mid)
  brand_strength      Float?                    @default(0.5)
  notes               String?                   @default("")
  city                String?                   @default("")
  country             String?                   @default("Indonesia")
  source              String?                   @default("map.co.id/brands")
  is_active           Boolean?                  @default(true)
  created_at          DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                  @default(now()) @db.Timestamptz(6)
  stores              Store[]
  tenant_id           String?
  tenant              Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([parent])
  @@index([tenant_id])
}

