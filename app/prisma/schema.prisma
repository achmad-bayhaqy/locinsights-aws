// =====================================================
// SaaS MULTI-TENANT MODELS (added in v5.0.0)
// Migration: 0009_saas_multi_tenant_auth.sql
// =====================================================

enum user_role_enum {
  superadmin
  admin
  tenant_admin
  data
  analyst
  viewer
}

enum tenant_plan_enum {
  saas_monthly
  saas_yearly
  enterprise_onprem
  trial
  internal
}

enum tenant_status_enum {
  active
  suspended
  terminated
  provisioning
}

enum addon_type_enum {
  region_expansion
  custom_scraper
  api_connector
  ui_customization
}

/// SaaS customer registry. Each row = one company subscribed to LocInsights.
model Tenant {
  @@map("tenants")
  id                  String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                String
  slug                String            @unique
  plan                tenant_plan_enum  @default(saas_monthly)
  status              tenant_status_enum @default(active)
  region_scope        String[]          @default([])
  data_residency      String?
  // White-labeling
  app_name            String            @default("LocInsights")
  logo_url            String?
  primary_color       String            @default("#7A0A1A")
  accent_color        String            @default("#C8102E")
  // Contact
  contact_name        String?
  contact_email       String?
  contact_phone       String?
  notes               String            @default("")
  // Limits
  max_users           Int               @default(10)
  max_api_calls_per_day Int             @default(10000)
  // Lifecycle
  trial_ends_at       DateTime?         @db.Timestamptz(6)
  suspended_at        DateTime?         @db.Timestamptz(6)
  terminated_at       DateTime?         @db.Timestamptz(6)
  // Audit
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @db.Timestamptz(6)
  created_by          String?

  users               User[]
  default_users       User[]   @relation("UserDefaultTenant")
  addons              TenantAddon[]
  brands              Brand[]
  stores              Store[]
  malls               Mall[]
  mall_tenants        MallTenant[]
  competitor_stores   CompetitorStore[]
  pois                Poi[]
  reports             Report[]
  scraper_runs        ScraperRun[]
  field_surveys       FieldSurvey[]
  ab_tests            ABTest[]
  ml_models           MLModel[]
  training_runs       TrainingRun[]
  predictions         Prediction[]
  staging_stores      StagingStore[]
  staging_competitors StagingCompetitor[]
  staging_malls       StagingMall[]
  docs                Doc[]
  roles               Role[]

  @@index([slug])
  @@index([status])
  @@index([plan])
}

/// Per-tenant add-ons (Skema C in SaaS pricing).
model TenantAddon {
  @@map("tenant_addons")
  id            String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenant_id     String
  addon_type    addon_type_enum
  addon_config  Json            @default("{}")
  expires_at    DateTime?       @db.Timestamptz(6)
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  created_by    String?
  tenant        Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([addon_type])
}

/// DB-backed documentation storage (replaces filesystem on Vercel).
model Doc {
  @@map("docs")
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug          String    @unique
  title         String
  category      String    @default("General")
  order         Int       @default(100)
  content       String    @default("")
  last_updated  DateTime  @default(now()) @db.Date
  owner         String    @default("Data Team")
  tenant_id     String?
  is_published  Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  tenant        Tenant?   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([category])
  @@index([tenant_id])
}

/// Auth — User table. tenant_id NULL = platform superadmin.
model User {
  @@map("users")
  id                 String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  username           String         @unique
  email              String?        @unique
  display_name       String?
  password_hash      String
  role               user_role_enum @default(viewer)
  is_active          Boolean        @default(true)
  failed_login_count Int            @default(0)
  locked_until       DateTime?      @db.Timestamp(6)
  last_login_at      DateTime?      @db.Timestamptz(6)
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime       @default(now()) @db.Timestamptz(6)
  created_by         String?
  // Multi-tenant
  tenant_id          String?
  default_tenant_id  String?
  tenant             Tenant?        @relation(fields: [tenant_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  default_tenant     Tenant?        @relation("UserDefaultTenant", fields: [default_tenant_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  audit_logs         UserAuditLog[]

  @@index([role])
  @@index([is_active])
  @@index([tenant_id])
  @@index([default_tenant_id])
}

/// Auth — Role table. permissions stored as JSON.
model Role {
  @@map("roles")
  id               String   @id
  name             String   @unique
  description      String?  @default("")
  permissions      Json     @default("{}")
  is_system        Boolean  @default(true)
  // Multi-tenant
  tenant_id        String?
  is_tenant_scoped Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  tenant           Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

/// Auth — Audit log for user actions (login, CRUD, lockout).
model UserAuditLog {
  @@map("user_audit_logs")
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id    String
  actor_id   String?
  action     String
  details    Json?
  ip_address String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
}
