  brand_id          String
  brand_name        String
  brand_category    brand_category_enum?
  parent            brand_parent_enum         @default(MAA)
  name              String
  lat               Float
  lng               Float
  geom              Unsupported("geography")? @default(dbgenerated("(st_makepoint(lng, lat))::geography"))
  kec               String?                   @default("")
  kab               String?                   @default("")
  city              String?                   @default("")
  country           String?                   @default("Indonesia")
  is_in_mall        Boolean?                  @default(false)
  mall_id           String?
  mall_name         String?
  address           String?                   @default("")
  opened_year       Int?
  estimated_size_m2 Int?                      @default(0)
  confirmed         Boolean?                  @default(false)
  source            String?                   @default("map.co.id directory")
  created_at        DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                  @default(now()) @db.Timestamptz(6)
  brands            Brand                    @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  malls             Mall?                    @relation(fields: [mall_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant_id           String?
  tenant              Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([brand_id], map: "stores_brand_idx")
  @@index([geom], type: Gist)
  @@index([kab])
  @@index([mall_id], map: "stores_mall_idx")
  @@index([tenant_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model TrainingRun {
  @@map("training_runs")
  id                 String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  model_id           String
  model_name         String
  algorithm          ml_algorithm_enum
  status             training_status_enum? @default(pending)
  dataset_size       Int?                  @default(0)
  features           Json?                 @default("[]")
  hyperparameters    Json?                 @default("{}")
  metrics            Json?                 @default("{}")
  feature_importance Json?                 @default("[]")
  model_artifact_url String?
  train_duration_ms  Int?
  error              String?
  started_at         DateTime              @default(now()) @db.Timestamptz(6)
  finished_at        DateTime?             @db.Timestamptz(6)
  ml_models          MLModel             @relation(fields: [model_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant_id           String?
  tenant              Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([model_id], map: "training_runs_model_idx")
  @@index([status])
  @@index([tenant_id])
}

// ============================================================================
// Authentication & RBAC models (Aug 2026 — DB-backed user management)
// ============================================================================
// Backs the NextAuth Credentials provider + the superadmin user-management
// panel. The first superadmin (`bayhaqy`) is bootstrapped from env vars on
// startup; subsequent users are created/managed via the admin UI.
//
// Roles:
//   - superadmin : full CRUD on all master data + can manage users/roles
//   - analyst    : read-only on analytics + can run ML/AI forecasts,
//                  cannot edit master data or manage users
//   - viewer     : read-only on dashboards/maps only — no mutations,
//                  no access to Data Manager / Scraper / Settings / Users
//
// Security notes:
//   - Passwords are stored as bcrypt hashes (10 rounds) — never plaintext.
//   - `is_active=false` disables login without deleting the user record.
//   - `failed_login_count` + `locked_until` enforce DB-side brute-force lockout.
//   - All mutations are audited via `UserAuditLog` for traceability.

