# LocInsights Environment Variables
# Copy this file to .env.local for local dev, or set these in your Vercel dashboard
# for production deployment.

# ----- AI Chat (required for the floating chat assistant) -----
# Get these from your /etc/.z-ai-config file or from Z.AI dashboard
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_API_KEY=your_zai_api_key_here
ZAI_TOKEN=your_jwt_token_here
ZAI_USER_ID=your_user_id_here
ZAI_CHAT_ID=your_chat_id_here

# ----- NextAuth (required for login + strict auth gate) -----
# Aug 2026: ALL app routes require authentication. Unauthenticated users are
# redirected to /login by middleware. The login page is the only public page.
#
# Generate a strong random secret: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-strong-random-secret-min-32-chars
NEXTAUTH_URL=https://locinsights.bayhaqy.my.id

# ----- Superadmin (managed via DB, NOT env vars) -----
# The `bayhaqy` superadmin is seeded DIRECTLY into the Supabase `users` table
# by running: `bun run scripts/seed-superadmin.ts`
#
# The script is idempotent — safe to re-run anytime:
#   - Creates the user if missing
#   - Upgrades them to superadmin if they exist with a lower role
#   - Rotates the password if `--reset-password` is passed
#   - Allows custom password via `--password "NewStrongPass123"`
#
# Default credentials after seeding:
#   username: bayhaqy
#   password: LockInsight@01!!
#
# To rotate the password later, run:
#   bun run scripts/seed-superadmin.ts --reset-password
#   bun run scripts/seed-superadmin.ts --password "NewStrongPass123"
#
# You no longer need NEXTAUTH_SUPERADMIN_USERNAME or
# NEXTAUTH_SUPERADMIN_PASSWORD_HASH env vars — these have been removed.

# ----- Database (already configured in prisma/schema.prisma) -----
# DATABASE_URL is set in Vercel — don't commit it to git

# ----- Map tiles (optional, defaults work fine) -----
# NEXT_PUBLIC_MAP_TILE_URL=https://cartodb-basemaps-a.global.ssl.fastly.net/light_all/{z}/{x}/{y}.png

# ----- Notes -----
# - All NEXT_PUBLIC_* vars are exposed to the browser; never put secrets there
# - ZAI_* vars are server-only (used in /api/locinsight/chat route)
# - If ZAI_* vars are not set, the chat route falls back to reading
#   .z-ai-config file (works in dev where /etc/.z-ai-config exists,
#   but NOT on Vercel — set the env vars there)
